rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Regra para ambiente de testes: Qualquer um pode ler, apenas o próprio usuário pode criar/editar seu perfil
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'leiroos@hotmail.com');
      allow delete: if request.auth != null && request.auth.token.email == 'leiroos@hotmail.com';
    }
    
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'leiroos@hotmail.com';
    }
  }
}
